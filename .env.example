# Configuração do Banco de Dados PostgreSQL Único (EventHub)
POSTGRES_DB=eventhub_db
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub_secret_2026
POSTGRES_PORT=5432

# Segredo compartilhado para assinatura e validação de tokens JWT (mínimo 256 bits)
JWT_SECRET=EventHubSuperSecretKeyForJwtAuthentication2026MicroservicesArchitecture
JWT_EXPIRATION_MS=86400000

# Porta pública do API Gateway + Aplicação Web
GATEWAY_PORT=8080

# Configuração do Message Broker RabbitMQ (Publish/Subscribe Assíncrono)
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=eventhub_secret_2026
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MESSAGING_ENABLED=true
